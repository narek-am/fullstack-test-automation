{
  "name": "shoplite-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end UI tests for ShopLite",
  "scripts": {
    "test": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:a11y": "playwright test --project=a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
