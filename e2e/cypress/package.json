{
  "name": "shoplite-cypress-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress UI tests for ShopLite, focused on network stubbing and custom commands",
  "scripts": {
    "start:app": "node scripts/start-app.mjs 3201",
