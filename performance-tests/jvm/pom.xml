<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.shoplite</groupId>
    <artifactId>shoplite-load-tests</artifactId>
    <version>1.0.0</version>
    <name>ShopLite load tests (Gatling, JMeter)</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gatling.version>3.16.0</gatling.version>
        <gatling-maven-plugin.version>4.21.12</gatling-maven-plugin.version>
        <jmeter-maven-plugin.version>3.8.0</jmeter-maven-plugin.version>
        <!-- Where the app under test runs (start it with ../scripts/start-app.mjs) -->
        <host>127.0.0.1</host>
        <port>3400</port>
        <!-- JMeter load size; override with e.g. -Dthreads=10 -Dduration=30 (max 50 threads = 50 users) -->
        <threads>25</threads>
        <rampUp>20</rampUp>
        <duration>60</duration>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <!-- users.csv is shared with the other load tools, so it is read from ../data -->
            <testResource>
                <directory>../data</directory>
            </testResource>
        </testResources>
        <plugins>
            <!-- ./mvnw gatling:test -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
                <configuration>
                    <simulationClass>shoplite.perf.ShopperJourneySimulation</simulationClass>
                    <jvmArgs>
                        <jvmArg>-DbaseUrl=http://${host}:${port}</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ./mvnw -Pjmeter verify -->
        <profile>
            <id>jmeter</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.lazerycode.jmeter</groupId>
                        <artifactId>jmeter-maven-plugin</artifactId>
                        <version>${jmeter-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>configuration</id>
                                <goals><goal>configure</goal></goals>
                            </execution>
                            <execution>
                                <id>jmeter-tests</id>
                                <goals><goal>jmeter</goal></goals>
                            </execution>
                            <execution>
                                <id>jmeter-check-results</id>
                                <goals><goal>results</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <generateReports>true</generateReports>
                            <testResultsTimestamp>false</testResultsTimestamp>
                            <!-- Fail the build if more than 1% of samples fail (including the 1 s duration assertion) -->
                            <errorRateThresholdInPercent>1</errorRateThresholdInPercent>
                            <propertiesUser>
                                <host>${host}</host>
                                <port>${port}</port>
                                <threads>${threads}</threads>
                                <rampUp>${rampUp}</rampUp>
                                <duration>${duration}</duration>
                            </propertiesUser>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
