{
  "info": {
    "name": "ShopLite API",
    "description": "Functional API tests for ShopLite. Folders run in order and pass data (token, IDs) through collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "productSchema",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"sku\",\"name\",\"description\",\"category\",\"priceCents\",\"stock\",\"inStock\",\"image\"],\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"sku\":{\"type\":\"string\",\"pattern\":\"^[A-Z]{2}-\\\\d{3}$\"},\"name\":{\"type\":\"string\",\"minLength\":1},\"description\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"},\"priceCents\":{\"type\":\"integer\",\"minimum\":1},\"stock\":{\"type\":\"integer\",\"minimum\":0},\"inStock\":{\"type\":\"boolean\"},\"image\":{\"type\":\"string\"}},\"additionalProperties\":false}"
    },
    {
      "key": "aliceToken",
      "value": ""
    },
    {
      "key": "bobToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Checks that run after every request in the collection.",
          "pm.test('responds within 1000 ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
          "pm.test('sends hardening headers', () => {",
          "  pm.response.to.have.header('X-Content-Type-Options', 'nosniff');",
          "  pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false;",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "      pm.test('service is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Products",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "      const schema = JSON.parse(pm.collectionVariables.get('productSchema'));",
                  "      pm.test('status 200', () => pm.response.to.have.status(200));",
                  "      pm.test('total matches number of items', () => pm.expect(body.total).to.eql(body.items.length));",
                  "      pm.test('response matches the product list schema', () => {",
                  "        pm.response.to.have.jsonSchema({",
                  "          type: 'object',",
                  "          required: ['items', 'total'],",
                  "          properties: { items: { type: 'array', items: schema }, total: { type: 'integer' } },",
                  "        });",
                  "      });",
                  "      pm.test('sorted by name by default', () => {",
                  "        const names = body.items.map((p) => p.name);",
                  "        pm.expect(names).to.eql([...names].sort());",
                  "      });",
                  "      const firstInStock = body.items.find((p) => p.inStock && p.stock >= 2);",
                  "      pm.collectionVariables.set('productId', firstInStock.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        },
        {
          "name": "Search products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const { items } = pm.response.json();",
                  "      pm.test('finds only matching products', () => {",
                  "        pm.expect(items).to.have.lengthOf.at.least(1);",
                  "        items.forEach((p) => pm.expect((p.name + ' ' + p.description).toLowerCase()).to.include('mug'));",
                  "      });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products?search=mug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "mug"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by category, sort by price desc",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const { items } = pm.response.json();",
                  "      pm.test('only hardware', () => items.forEach((p) => pm.expect(p.category).to.eql('hardware')));",
                  "      pm.test('prices descending', () => {",
                  "        const prices = items.map((p) => p.priceCents);",
                  "        pm.expect(prices).to.eql([...prices].sort((a, b) => b - a));",
                  "      });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=hardware&sort=price_desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "hardware"
                },
                {
                  "key": "sort",
                  "value": "price_desc"
                }
              ]
            }
          }
        },
        {
          "name": "Get product by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "      pm.test('returns the requested product', () => {",
                  "        pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('productId')));",
                  "      });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "{{productId}}"
              ]
            }
          }
        },
