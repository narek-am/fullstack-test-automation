    {
      "name": "04 Cart",
      "item": [
        {
          "name": "Add 2 items to cart",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Body placeholders are strings; send the product id as a number.",
                  "      const body = JSON.parse(pm.request.body.raw.replace('\"{{productId}}\"', pm.collectionVariables.get('productId')));",
                  "      pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cart = pm.response.json();",
                  "      pm.test('status 201', () => pm.response.to.have.status(201));",
                  "      pm.test('line total is quantity x unit price', () => {",
                  "        const line = cart.items.find((i) => i.productId === Number(pm.collectionVariables.get('productId')));",
                  "        pm.expect(line.quantity).to.eql(2);",
                  "        pm.expect(cart.subtotalCents).to.eql(line.unitPriceCents * 2);",
                  "      });",
                  "      pm.test('total = subtotal + shipping', () => {",
                  "        pm.expect(cart.totalCents).to.eql(cart.subtotalCents + cart.shippingCents);",
                  "      });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cart",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
