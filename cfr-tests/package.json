{
  "name": "shoplite-cfr-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-functional requirement tests for ShopLite: chaos experiments and architecture rules",
  "scripts": {
    "chaos": "playwright test",
    "architecture": "cd ../app && depcruise --config ../cfr-tests/architecture/dependency-cruiser.cjs src public/js",
    "architecture:graph": "cd ../app && depcruise --config ../cfr-tests/architecture/dependency-cruiser.cjs --output-type mermaid src > ../cfr-tests/architecture/dependency-graph.mmd",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.0",
    "dependency-cruiser": "18.6.0",
    "typescript": "5.7.2"
  }
}
